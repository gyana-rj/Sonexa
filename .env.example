# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sonexa_db
POSTGRES_PORT=5432

# App — host must be the compose service name `postgres` inside Docker
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/sonexa_db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# OAuth (optional — leave empty to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Host port for the web container
WEB_PORT=3000
